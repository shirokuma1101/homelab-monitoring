# Host ports reserved for homelab-monitoring (11000-11999).
GRAFANA_PORT=11000
GRAPHITE_METRICS_PORT=11001
GRAPHITE_RECEIVER_PORT=11002
TAILSCALE_PROXY_PORT=11003
