GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
VICTORIAMETRICS_URL=https://example.invalid

# Required only for the tailscale-node profile.
TAILSCALE_AUTHKEY=tskey-auth-replace-me
